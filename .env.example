# ─── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here

# Internal secret shared between bot and API — generate with: openssl rand -hex 32
BOT_SECRET=change_me_in_production

# ─── Database ──────────────────────────────────────────────────────────────────
# Connects DIRECTLY to the PostgreSQL instance — NOT through the Supabase SDK.
# The Supabase SDK is only used for Storage (file uploads).
#
# Self-hosted Supabase:
#   Find the connection string in your Supabase dashboard → Settings → Database.
#   Use the direct connection (port 5432) or PgBouncer pooler (port 6543) if configured.
#   Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
#
# Example (self-hosted, direct):
# DATABASE_URL=postgresql+asyncpg://postgres:your-password@your-server-ip:5432/postgres
#
# Example (self-hosted, via PgBouncer):
# DATABASE_URL=postgresql+asyncpg://postgres:your-password@your-server-ip:6543/postgres
#
# Local dev (docker-compose):
DATABASE_URL=postgresql+asyncpg://artflow:artflow@localhost:5434/artflow

# Connection pool per process (API and each worker). Keep the total under the
# server's max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=50

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Supabase (Storage + SDK) ──────────────────────────────────────────────────
# Used ONLY for file storage (portfolio images, WIP images, payment receipts).
#
# Self-hosted Supabase:
#   SUPABASE_URL = the base URL of your Kong API gateway.
#   Default self-hosted port is 8000. Use your domain if you've set up a reverse proxy.
#   e.g. http://your-server-ip:8000  or  https://supabase.yourdomain.com
#
#   SUPABASE_SERVICE_KEY = the service_role JWT.
#   In your self-hosted setup, this is generated from your SERVICE_ROLE_KEY secret.
#   Find it in: supabase/config.toml or the .env file of your self-hosted install,
#   or generate it at https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
#
SUPABASE_URL=http://your-server-ip:8000
SUPABASE_SERVICE_KEY=your_service_role_jwt_here

# Storage bucket names (change only if you rename buckets in the dashboard)
STORAGE_BUCKET_PORTFOLIO=portfolio
STORAGE_BUCKET_WIP=wip
STORAGE_BUCKET_RECEIPTS=receipts

# ─── Application ───────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development
# Base URL used to construct email verification links sent in DMs
API_BASE_URL=http://localhost:8000

# ─── Email Verification ────────────────────────────────────────────────────────
# Token TTL in seconds (default: 86400 = 24 hours)
EMAIL_VERIFY_TTL=86400

# ─── Observability ─────────────────────────────────────────────────────────────
# Leave empty to disable Sentry
SENTRY_DSN=
